rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    // Users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reviews collection
    // Anyone can read
    // Any authenticated user can create
    // Only owner can update/delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Watchlist collection
    // Users can only read/write their own watchlist documents
    match /watchlist/{docId} {
      // Use resource.data for reading/deleting existing documents
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userID;
      // Use request.resource.data for creating/updating new documents
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.userID;
    }

    // Watch History collection (New!)
    // Users can only read/write their own watch history based on the path
    match /watchHistory/{userId}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin collections (movies, tvShows) - Deny by default, only allow if admin claim is present
    match /movies/{movieId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    match /tvShows/{tvShowId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
