{
  "name": "netflyer-backend",
  "version": "2.0.0",
  "description": "Fast, secure TypeScript API for netflyer streaming platform",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && echo '✓ TypeScript check passed'",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "api",
    "streaming",
    "tmdb",
    "typescript",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^7.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
